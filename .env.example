# Copy to .env and replace every placeholder. Never commit the real .env file.
NEXTAUTH_SECRET=replace-with-a-long-random-value
SALT=replace-with-a-long-random-value
ENCRYPTION_KEY=replace-with-64-random-hex-characters
POSTGRES_PASSWORD=replace-with-a-random-password
CLICKHOUSE_PASSWORD=replace-with-a-random-password
REDIS_AUTH=replace-with-a-random-password
MINIO_ROOT_PASSWORD=replace-with-a-random-password
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=replace-with-langfuse-public-key
LANGFUSE_INIT_PROJECT_SECRET_KEY=replace-with-langfuse-secret-key
LANGFUSE_INIT_USER_EMAIL=replace-with-admin-email
LANGFUSE_INIT_USER_NAME=Local Admin
LANGFUSE_INIT_USER_PASSWORD=replace-with-a-strong-password

# Spring Boot expects: Basic base64("publicKey:secretKey")
OTEL_EXPORTER_OTLP_AUTHORIZATION=replace-with-basic-authorization-header
